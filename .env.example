# FinTrace Environment Variables
# Copy this file to .env and fill in your values

# JWT
JWT_SECRET=your_jwt_secret_here

# Redis (local dev - use host/port)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Redis (production/Render - use REDIS_URL instead of host/port)
# REDIS_URL=rediss://red-xxxxx:6379

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Database (local dev)
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Database (Render - auto-set via render.yaml, includes SSL)
# DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"
